#!/usr/bin/env bash

# Installs dotfiles and config folders.
# modified from https://github.com/holman/dotfiles

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e
echo ''

# helper functions
info () { printf "\r  [ \033[00;34m..\033[0m ] $1\n"; }
user () { printf "\r  [ \033[0;33m??\033[0m ] $1\n"; }
success () { printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"; }
fail () { printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"; echo ''; exit 1; }

# Setup Git configuration
# Checks for git/gitconfig.local.symlink
# If it doesn't, create it.
setup_gitconfig () {
  if ! [ -f git/gitconfig.local.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

    success 'gitconfig'
  fi
}

# Ensure parent directories exist
ensure_directory_exists () {
  local dir=$1
  if [ ! -d "$(dirname "$dir")" ]; then
    info "creating parent directory for $dir"
    mkdir -p "$(dirname "$dir")"
    success "created parent directory for $dir"
  fi
}


# Symlink a source file to a destination file
link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  # Ensure parent directory exists
  ensure_directory_exists "$dst"

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

# Symlink a directory
link_directory () {
  local src=$1 dst=$2

  skip=false

  # Ensure parent directory exists
  ensure_directory_exists "$dst"

  if [ -d "$dst" -o -L "$dst" ]
  then
    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then
      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then
        skip=true
      else
        user "Directory already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o ) overwrite=true;;
          O ) overwrite_all=true;;
          b ) backup=true;;
          B ) backup_all=true;;
          s ) skip=true;;
          S ) skip_all=true;;
          * ) ;;
        esac
      fi
    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]
  then
    ln -s "$src" "$dst"
    if [ $? -eq 0 ]; then
      success "linked $src to $dst"
    else
      fail "failed to link $src to $dst"
    fi
  fi
}

# Setup directory structure
setup_directory_structure() {
  info 'setting up directory structure'
  
  # Ensure ~/.config exists
  if [ ! -d "$HOME/.config" ]; then
    info "creating $HOME/.config"
    mkdir -p "$HOME/.config"
    success "created $HOME/.config"
  fi
  
  # Dynamically find all config directories that need to be created
  for src in $(find -H "$DOTFILES_ROOT/config" -mindepth 1 -maxdepth 1 -type d -not -path '*.git*')
  do
    dst="$HOME/.config/$(basename "$src")"
    # Only create parent directory, not the actual target
    parent_dir="$(dirname "$dst")"
    if [ ! -d "$parent_dir" ]; then
      info "creating $parent_dir"
      mkdir -p "$parent_dir"
      success "created $parent_dir"
    fi
  done
}

# Install dotfiles using found .symlink files
# Install directories in /config to ~/.config
install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  # Symlinks .symlink files to home dir
  for src in $(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*.git*')
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done

  # Symlinks folders in /config to ~/.config/
  for src in $(find -H "$DOTFILES_ROOT/config" -mindepth 1 -maxdepth 1 -type d -not -path '*.git*')
  do
    dst="$HOME/.config/$(basename "$src")"
    link_directory "$src" "$dst"
  done
}

# Setup macOS-specific tools
setup_macos() {
  if [ "$(uname -s)" == "Darwin" ]; then
    info "Setting up macOS environment"
    
    # Install Homebrew if it's not already installed
    if ! command -v brew >/dev/null 2>&1; then
      info "Installing Homebrew"
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      success "Homebrew installed"
    fi
  fi
}

run_all() {
  setup_gitconfig
  setup_directory_structure
  install_dotfiles
  setup_macos
  
  # Run the install script if it exists
  if [ -x "script/install" ]; then
    info "Running install script"
    script/install
  fi
  
  echo ''
  echo '  All installed!'
}

# Run the bootstrap process
run_all
